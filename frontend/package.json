{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "type": "module",
  "scripts": {
    "analyze": "RSDOCTOR=true bun run build",
    "build": "bun run theme:check && NODE_OPTIONS=--max_old_space_size=16384 rsbuild build",
    "build-local-test": "REACT_APP_BUSINESS=true REACT_APP_CONSOLE_GIT_SHA=abc123 REACT_APP_CONSOLE_GIT_REF=local REACT_APP_BUILD_TIMESTAMP=32503680000 REACT_APP_DEV_HINT=true NODE_OPTIONS=--max_old_space_size=16384 rsbuild build",
    "doctor": "react-doctor . -y --blocking error --scope changed --base origin/master",
    "e2e-test": "node tests/scripts/run-all-variants.mjs",
    "e2e-test:dev": "E2E_DEV_MODE=true node tests/scripts/run-variant.mjs console --ui",
    "e2e-test:variant": "node tests/scripts/run-variant.mjs",
    "e2e-test-enterprise:dev": "E2E_DEV_MODE=true node tests/scripts/run-variant.mjs console-enterprise --ui",
    "format": "biome format src/* --write",
    "format:check": "biome format src/*",
    "install:chromium": "playwright install chromium",
    "lint": "ultracite fix || true",
    "lint:check": "ultracite check",
    "lint:check:file": "ultracite check",
    "lint:file": "ultracite fix",
    "load-git-hooks": "cd .. && git config core.hooksPath \"./.git-hooks\"",
    "prepare": "lefthook install",
    "preview": "rsbuild preview",
    "quality:gate": "bun run lint && bun run doctor && bun run type:check && bun run build && bun run test:unit && bun run test:integration",
    "start": "rsbuild dev",
    "start:cloud": "./start-cloud.sh",
    "start2": "REACT_APP_ENABLED_FEATURES=SINGLE_SIGN_ON,REASSIGN_PARTITIONS rsbuild dev",
    "test": "bun run test:ci",
    "test:ci": "bun run test:unit && bun run test:integration && bun run test:federation",
    "test:coverage": "TZ=GMT rstest --config=rstest.config.unit.ts --coverage && NODE_OPTIONS='--max_old_space_size=8192' TZ=GMT rstest --config=rstest.config.integration.ts --coverage && node scripts/merge-coverage.mjs && node scripts/check-coverage-thresholds.mjs",
    "test:federation": "NODE_OPTIONS='--max_old_space_size=8192' TZ=GMT rstest --config=rstest.config.federation.ts",
    "test:file:integration": "NODE_OPTIONS='--max_old_space_size=8192' TZ=GMT rstest --config=rstest.config.integration.ts",
    "test:file:unit": "TZ=GMT rstest --config=rstest.config.unit.ts",
    "test:integration": "NODE_OPTIONS='--max_old_space_size=8192' TZ=GMT rstest --config=rstest.config.integration.ts",
    "test:unit": "TZ=GMT rstest --config=rstest.config.unit.ts",
    "test:watch": "TZ=GMT rstest --config=rstest.config.ts --watch",
    "theme:check": "bun src/components/redpanda-ui/style/theme-check/cli.mts --overrides src/globals.css",
    "type:check": "tsc --noEmit --incremental -p tsconfig.base.json",
    "type:check:file": "tsc --noEmit -p tsconfig.base.json",
    "ultracite": "ultracite"
  },
  "resolutions": {
    "dompurify": "^3.4.12",
    "fast-uri": "^3.1.4",
