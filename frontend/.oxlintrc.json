{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript"],
  "jsPlugins": ["./lint-rules/index.ts"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "console/no-hookless-use-function": "error",
    "console/no-real-time-wait-in-tests": "error",
    "console/no-polling-loop-in-tests": "error",
    "console/no-wall-clock-in-tests": "error",
    "console/no-test-timeout-or-unreasoned-skip": "error",
    "console/require-suppression-reason": "error",
    "console/no-native-title-tooltip": "error",
    "oxc/bad-array-method-on-arguments": "error",
    "oxc/bad-char-at-comparison": "error",
    "oxc/bad-comparison-sequence": "error",
    "oxc/bad-match-all-arg": "error",
    "oxc/bad-min-max-func": "error",
    "oxc/bad-object-literal-comparison": "error",
    "oxc/bad-replace-all-arg": "error",
    "oxc/const-comparisons": "error",
    "oxc/double-comparisons": "error",
    "oxc/erasing-op": "error",
    "oxc/misrefactored-assign-op": "error",
    "oxc/missing-throw": "error",
    "oxc/no-this-in-exported-function": "error",
    "oxc/number-arg-out-of-range": "error",
    "oxc/only-used-in-recursion": "error",
    "oxc/uninvoked-array-callback": "error"
  },
  "options": {
    "reportUnusedDisableDirectives": "error",
    "typeAware": true,
    "typeCheck": false
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/routeTree.gen.ts",
    "**/protogen/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/coverage*/**",
    "**/.nyc_output/**",
    "**/.rstest/**",
    "**/.cache/**",
    "src/components/redpanda-ui/**",
    "src/components/ui/**",
    "tests/console/**",
    "tests/console-enterprise/**"
  ],
  "overrides": [
    {
      "files": ["tests/shared/assertions.ts"],
      "rules": {
        "console/no-real-time-wait-in-tests": "off",
        "console/no-polling-loop-in-tests": "off",
        "console/no-wall-clock-in-tests": "off"
      }
    },
    {
      "files": ["tests/shared/global-setup.mjs"],
      "rules": {
        "console/no-real-time-wait-in-tests": "off"
      }
    },
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "typescript/await-thenable": "error",
        "typescript/no-array-delete": "error",
        "typescript/no-for-in-array": "error",
        "typescript/no-implied-eval": "error",
        "typescript/no-misused-spread": "error",
        "typescript/no-unsafe-unary-minus": "error"
      }
    },
    {
      "files": ["src/**/*.test.{ts,tsx}"],
      "rules": {
        "typescript/await-thenable": "off"
      }
    }
  ]
}
