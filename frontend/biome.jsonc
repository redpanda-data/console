{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "master"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*",
      "!**/routeTree.gen.ts",
      "!**/protogen",
      "!**/protogen/**/*",
      "!**/dist/**/*",
      "!**/build/**/*",
      "!**/out/**/*",
      "!**/coverage/**/*",
      "!**/.nyc_output/**/*",
      "!**/*.css",
      "!**/*.svg",
      "!**/*.html",
      // Keep the pre-2.6 file scope; Markdown, YAML, and SCSS need separate adoption.
      "!**/*.{md,mdx,yaml,yml,scss}",
      "!**/tests/global-setup.mjs",
      "!**/tests/console",
      "!**/tests/console-enterprise",
      "!**/components/redpanda-ui",
      "!**/assets/rp-connect-schema-full.json",
      "!**/components/ui"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "attributePosition": "auto",
    "bracketSpacing": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [":PACKAGE:", ":BLANK_LINE:", ["@/**"], ":BLANK_LINE:", ["./**"]]
          }
        },
        "useSortedAttributes": "on",
        "useSortedKeys": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useMathMinMax": "error"
      },
      "correctness": {
        // tsconfig maps "*" to src/*, so this rule reads every internal import
        // (`components/…`, `utils/…`) as an undeclared npm package.
        "noUndeclaredDependencies": "off",
        "useImageSize": "off",
        "useJsonImportAttributes": "error" // this may slow down the linting process
      },
      "performance": {
        "noJsxPropsBind": "off", // React Compiler (rsbuild.config.ts) memoizes inline callbacks
        "useDomNodeTextContent": "error"
      },
      "nursery": {
        "noAccidentalBitwiseOperators": "error",
        "noArgumentsCallerOrCallee": "error",
        "noDoubleComparison": "error",
        "noExcessiveStatementsPerFunction": "error",
        "noFloatingPromises": { "level": "error", "fix": "none" },
        "noInvalidThis": "error",
        "noMisusedPromises": { "level": "error", "fix": "none" },
        "noNestedSwitch": "error",
        "noNestedTemplateLiterals": "error",
        "noObjectConstructor": "error",
        "noOctal": "error",
        "noProcessExit": "error",
        "noPromiseExecutorReturn": "error",
        "noTailwindLegacyUtilities": "error",
        "noTailwindRestyledComponents": "error",
        "noUnsafeUnaryMinus": "error",
        "noUselessAssignment": "error",
        "noUselessCall": "error",
        "noUselessDateGetTime": "error",
        "noZeroFractions": "error",
        "useBigintLiterals": "error",
        "useCapitalizedConstructors": "error",
        "useConsistentJsonFileRead": "error",
        "useExhaustiveSwitchCases": "error", // this may slow down the linting process
        "useLowercaseTestTitle": "error",
        "useMatchingFunctionName": "error",
        "useNamedFunction": "error",
        "useSimplifiedBooleanReturn": "error",
        "useTailwindStaticClassStrings": "error",
        "useUnaryMinus": "error"
      },
      "style": {
        "noDefaultExport": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "mobx": "Deprecated — use Zustand instead",
              "mobx-react-lite": "Deprecated — use Zustand instead",
              "yup": "Deprecated — use Zod instead"
            },
            "patterns": [
              {
                "group": [
                  "vitest",
                  "vitest/**",
                  "@vitest/**",
                  "jsdom",
                  "jsdom/**",
                  "@playwright/test",
                  "@playwright/test/**"
                ],
                "message": "Use Bun for units, Happy DOM for DOM integration, and Rstest with native Playwright for browser/E2E tests."
              }
            ]
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useReactFunctionComponents": "off"
      },
      "suspicious": {
        "noConsole": "error",
        "noFocusedTests": "error",
        "noReactForwardRef": "off",
        "noDeprecatedImports": "error",
        "noImportCycles": "off"
      }
    }
  },
  "tailwind": {
    "stylesheet": "./src/globals.css",
    "mergeFunctions": ["clsx", "tw", "twMerge", "cn", "twJoin"],
    "variantFunctions": ["cva", "tv"]
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "single",
      "quoteProperties": "asNeeded",
      "semicolons": "always",
      "trailingCommas": "es5"
    },
    "jsxRuntime": "reactClassic"
  },
  "json": {
    "assist": {
      "enabled": false
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "lineWidth": 120,
      "trailingCommas": "none"
    },
    "parser": {
      "allowComments": false,
      "allowTrailingCommas": false
    }
  },
  "css": {
    "formatter": {
      "lineEnding": "lf",
      "lineWidth": 120,
      "quoteStyle": "single"
    },
    "parser": {
      "allowWrongLineComments": false,
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      // TODO(lint-debt): rules with violations that predate the Biome 2.5 / Ultracite 8
      // upgrade, held at "warn" so new errors and config mistakes still fail `bun run lint`.
      // The lint follow-up fixes these and deletes this block. Kept first so the
      // file-specific overrides below still win.
      "includes": ["**"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "warn",
            "noNoninteractiveTabindex": "warn",
            "noStaticElementInteractions": "warn",
            "useAriaPropsSupportedByRole": "warn",
            "useButtonType": "warn",
            "useSemanticElements": "warn"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "warn",
            "noRedundantDefaultExport": "warn",
            "noUselessCatchBinding": "warn",
            "noUselessFragments": "warn",
            "noVoid": "warn",
            "useLiteralKeys": "warn"
          },
          "correctness": {
            "noUnusedFunctionParameters": "warn",
            "noUnusedVariables": "warn",
            "useYield": "warn"
          },
          "performance": {
            "noBarrelFile": "warn",
            "useTopLevelRegex": "warn"
          },
          "style": {
            "noIncrementDecrement": "warn",
            "noNestedTernary": "warn",
            "noNonNullAssertion": "warn",
            "noParameterProperties": "warn",
            "noSubstr": "warn",
            "useConsistentMethodSignatures": "warn",
            "useConsistentTypeDefinitions": {
              "level": "warn",
              "options": {
                "style": "type"
              }
            },
            "useDestructuring": "warn",
            "useErrorCause": "warn",
            "useReadonlyClassProperties": "warn"
          },
          "suspicious": {
            "noArrayIndexKey": "warn",
            "noAssignInExpressions": "warn",
            "noBitwiseOperators": "warn",
            "noDeprecatedImports": "warn",
            "noDoubleEquals": "warn",
            "noEmptyBlockStatements": "warn",
            "noEmptySource": "warn",
            "noEqualsToNull": "warn",
            "noForIn": "warn",
            "noLeakedRender": "warn",
            "noNestedPromises": "warn",
            "noShadow": "warn",
            "noTemplateCurlyInString": "warn",
            "noUnnecessaryConditions": "warn",
            "useErrorMessage": "warn",
            "useIterableCallbackReturn": "warn"
          }
        }
      }
    },
    {
      "includes": ["**/*.{test,spec}.{ts,tsx,js,jsx}", "**/__tests__/**/*", "rstest.setup*.ts", "**/*-test-helpers.ts"],
      "javascript": {
        // rstest `globals: true` injects these at runtime (typed via @rstest/core/globals)
        "globals": ["rs", "test", "it", "expect", "describe", "beforeEach", "afterEach", "beforeAll", "afterAll"]
      },
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          },
          "suspicious": {
            "noConsole": "off",
            // Ultracite's own test exemption, which the lint-debt block above would otherwise override
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**/*", "**/bin/**/*", "*.mjs", "*.cjs", "**/tests/**/*", "**/tests/*.sh"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.d.ts", "**/{env,global,types}.d.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUndeclaredVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["**/dist/**/*", "**/build/**/*", "**/out/**/*", "**/coverage/**/*", ".env", ".env.*"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "package.json",
        "{tsconfig,jsconfig}.json",
        "tsconfig.*.json",
        ".vscode/*.json",
        ".github/**/*.json"
      ],
      "json": {
        "parser": {
          "allowComments": true,
          "allowTrailingCommas": true
        }
      }
    },
    {
      "includes": ["**/routes/**/*"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
