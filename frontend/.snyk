# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JS-POSTCSS-18313038:
    - '*':
        reason: >-
          Not reachable from attacker input in Console UI: vulnerable PostCSS is
          build tooling used by Rsbuild and Vite. The build consumes
          repository-controlled CSS and source maps; no server endpoint
          processes user-submitted CSS or returns generated source maps.
        expires: 2026-10-27T00:00:00.000Z
        created: 2026-07-29T12:58:49.133Z
patch: {}
