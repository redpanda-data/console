# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JS-UUID-16133035:
    - '*':
        reason: >-
          Not reachable in browser UI: frontend source has no direct uuid
          runtime imports and does not call uuid v3/v5/v6 with caller-provided
          output buffers/offsets. Remaining paths are @a2a-js/sdk, Mermaid via
          streamdown, @hookform/devtools via @redpanda-data/ui, SockJS
          dev-server tooling, and Docker test tooling; none expose the
          vulnerable external-buffer API to user input. Revisit before expiry or
          if direct uuid buffer APIs are introduced. Re-triaged 2026-07-20 sweep
          — still present, still non-reachable.
        expires: 2026-10-20T00:00:00.000Z
        created: 2026-05-13T09:58:12.566Z
  SNYK-JS-BODYPARSER-17906397:
    - '*':
        reason: >-
          Not reachable in Console UI: body-parser is only under the MCP SDK
          Express server path. Frontend imports MCP client modules and never
          starts Express or accepts HTTP request bodies.
        expires: 2026-10-27T00:00:00.000Z
        created: 2026-07-29T12:36:53.133Z
  SNYK-JS-HONONODESERVER-18170326:
    - '*':
        reason: >-
          Not reachable in Console UI: @hono/node-server is only an MCP SDK
          server transport. Frontend imports MCP client modules and never serves
          files through Hono. Fixed 1.19.17 is also inside the 72-hour
          release-age gate.
        expires: 2026-10-27T00:00:00.000Z
        created: 2026-07-29T12:36:55.470Z
  SNYK-JS-IPADDRESS-16636412:
    - '*':
        reason: >-
          Not reachable in Console UI: ip-address is only under the MCP SDK
          Express rate-limit server path. Frontend never starts that server or
          renders ip-address HTML helpers.
        expires: 2026-10-27T00:00:00.000Z
        created: 2026-07-29T12:36:57.976Z
  SNYK-JS-POSTCSS-18313038:
    - '*':
        reason: >-
          Not reachable from attacker input in Console UI: vulnerable PostCSS is
          under Vue compiler-sfc tooling pulled by Milkdown. The browser UI does
          not compile or write attacker-controlled CSS or source maps.
        expires: 2026-10-27T00:00:00.000Z
        created: 2026-07-29T12:37:00.008Z
patch: {}
