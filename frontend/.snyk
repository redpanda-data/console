# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JS-UUID-16133035:
    - '*':
        reason: >-
          Not reachable in browser UI: frontend source has no direct uuid
          runtime imports and does not call uuid v3/v5/v6 with caller-provided
          output buffers/offsets. Remaining paths are @hookform/devtools via
          @redpanda-data/ui and Docker test tooling; neither exposes the
          vulnerable external-buffer API to user input. Revisit before expiry
          or if direct uuid buffer APIs are introduced. Re-triaged 2026-07-20
          sweep — still present, still non-reachable.
        expires: 2026-10-20T00:00:00.000Z
        created: 2026-05-13T09:58:12.566Z
  SNYK-JS-POSTCSS-18313038:
    - '*':
        reason: >-
          Not reachable from attacker input in Console UI: vulnerable PostCSS is
          build tooling used by Rsbuild and Vite. The build consumes
          repository-controlled CSS and source maps; no server endpoint
          processes user-submitted CSS or returns generated source maps.
        expires: 2026-10-27T00:00:00.000Z
        created: 2026-07-29T12:58:49.133Z
patch: {}
