    - '@rsbuild/plugin-node-polyfill@1.4.6 > crypto-browserify@3.12.1 > browserify-sign@4.2.5 > elliptic@6.6.1':
        reason: >-
          crypto-browserify polyfill graph only. No first-party elliptic
